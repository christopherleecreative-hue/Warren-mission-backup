name: warren-mission-backup
on:
  schedule:
    - cron: "40 0 * * *"      # 00:40 UTC daily, after the UTC day closes
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: write
jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Verify files are intact
        run: sha256sum -c SHA256SUMS
      - name: Rebuild the books from public BTC Markets prices (no AI, no secrets)
        run: python cloud_run.py
      - name: Save results
        run: |
          git config user.name "warren-mission-bot"
          git config user.email "warren-mission-bot@users.noreply.github.com"
          git add results
          git commit -m "results $(date -u +%F)" || echo "no change"
          git push
